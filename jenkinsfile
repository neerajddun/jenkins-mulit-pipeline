pipeline {

    agent any 

    environment {

        CI = 'true'
        IAMGE_NAME = "${dockerfile}"
    }

    stages {

        stage ('Build') {

            steps {

                sh 'docker build -t ${IMAGE_NAME} . '
                sh 'docker tag ${IMAGE_NAME} neeraj91/${IMAGE_NAME} '
            }
        }

        stage ('Test') {

            steps { 

                sh 'docker run --rm dockerfile python -m pytest -v'
            }
        }

        stage ('Docker Push') {

            steps {

               withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', passwordVariable: 'DockerPass', usernameVariable: 'DockerName')]) {

                sh 'echo "${DockerPass}" | docker login -u "${DockerName}" --password-stdin'
                sh 'docker push neeraj91/${IMAGE_NAME}'
                }
            }
        }
    }

}