pipeline {

    agent any 

    environment {

        IMAGE_NAME = "flask-app"
        IMAGE_TAG = "v1.${BUILD_NUMBER}"
    }

    stages {

        stage ('Build') {

            steps {

                sh 'docker build -t ${IMAGE_NAME}:${IMAGE_TAG} . '
                sh 'docker tag ${IMAGE_NAME}:${IMAGE_TAG} neeraj91/${IMAGE_NAME}:${IMAGE_TAG} '
            }
        }

        stage ('Test') {

            steps { 

                sh 'docker run --rm ${IMAGE_NAME}:${IMAGE_TAG} python -m pytest -v'
            }
        }

        stage ('Docker Push') {

            steps {

               withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', passwordVariable: 'DockerPass', usernameVariable: 'DockerName')]) {

                sh 'echo "${DockerPass}" | docker login -u "${DockerName}" --password-stdin'
                sh 'docker push neeraj91/${IMAGE_NAME}:${IMAGE_TAG}'
                }
            }
        }

        stage('Deploy to dev') {
           
            when {
           
                branch 'dev'
           
            }
           
            steps {
           
                sh 'docker rm -f flask-dev || true'
                sh 'docker run -d --name flask-dev -p 5001:5000 ${IMAGE_NAME}:${IMAGE_TAG}'
                timeout(time: 10, unit: 'MINUTES') {
                    input message: 'Finished checking the dev site on port 5001? (Click "Proceed" to stop it)'
                }
            }
           
            post {
           
                always {
           
                    sh 'docker rm -f flask-dev || true'
                }
            }
        }

        stage('Deploy to prod') {
            
            when {
           
                branch 'prod'
           
            }
           
            steps {
           
                input message: 'Deploy to production?', ok: 'Deploy'
                sh 'docker rm -f flask-prod || true'
                sh 'docker run -d --name flask-prod -p 5002:5000 ${IMAGE_NAME}'
           
            }
        }
    }
}